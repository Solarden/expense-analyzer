# Copy to .env and adjust. All settings are prefixed with EA_.
EA_APP_NAME=Expense Analyzer
EA_DEBUG=false
# Full SQLAlchemy database URL. Production is the shared PostgreSQL server (the
# /opt/stack compose on the Pi) — create the app's database and role there once:
#   CREATE ROLE expense_analyzer LOGIN PASSWORD '...';
#   CREATE DATABASE expense_analyzer OWNER expense_analyzer;
# For zero-setup local dev a SQLite URL works too:
#   EA_DATABASE_URL=sqlite:///data/expense_analyzer.db
EA_DATABASE_URL=postgresql+psycopg://expense_analyzer:CHANGE-ME@192.168.1.206:5432/expense_analyzer
# The app's file-data directory (update status file; attachments default lives
# here too). The compose file pins this to the mounted /data volume.
EA_DATA_PATH=data
# Loan attachments (Phase 21): where uploaded loan documents are stored (the
# compose file pins /data/attachments) and the max size of one upload, in bytes.
# Local-only; allowed types (PDF/JPEG/PNG/WebP) are fixed in code. Default 10 MiB.
EA_ATTACHMENTS_PATH=data/attachments
EA_ATTACHMENT_MAX_BYTES=10485760
# Max documents per loan (guards against an accidental mass upload).
EA_ATTACHMENT_MAX_PER_LOAN=50
# Display/bucketing timezone (the app works in UTC internally).
EA_TIMEZONE=Europe/Warsaw
# Max gap (days) between the two legs of an internal transfer for them to pair.
# Default 5 covers PL long-weekend/holiday settlement delays (ELIXIR is biz-days).
EA_TRANSFER_WINDOW_DAYS=5
# Rows per page on the transaction list.
EA_PAGE_SIZE=50
# Source code URL shown as a "Source" link in the UI (AGPL §13). If you run a
# MODIFIED version, point this at your own published source.
EA_SOURCE_URL=https://github.com/Solarden/expense-analyzer
# Plan-vs-reality loan matching: max gap (days) and amount tolerance (percent of
# the planned installment) for suggesting a transaction as an installment payment.
EA_LOAN_MATCH_WINDOW_DAYS=5
EA_LOAN_MATCH_AMOUNT_TOLERANCE_PCT=5
# Secret for signing session cookies. CHANGE THIS to a long random value, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
EA_SECRET_KEY=change-me-to-a-long-random-value
# Mark the session cookie Secure (HTTPS-only). Keep true in production (behind
# Caddy TLS); set false only for plain-http local dev.
EA_SECURE_COOKIES=true
# The domain you reach the app at — Caddy issues a trusted Let's Encrypt cert for
# it via the ACME DNS-01 challenge (no inbound, no port-forward). Must resolve to
# the Pi's LAN IP on your network (router DNS / Pi-hole / hosts entry). For a
# plain offline LAN setup without a domain, a bare hostname (expense.local) still
# works but falls back to a self-signed cert only if you restore `tls internal`.
CADDY_SITE_ADDRESS=expense.szawel.com
# GoDaddy API credentials for the DNS-01 challenge, as "<KEY>:<SECRET>". Get a
# *Production* key (NOT the OTE/test one) at https://developer.godaddy.com/keys.
# Used only to create/delete the TXT record when issuing/renewing the cert — no
# runtime egress beyond that. Leave CADDY_SITE_ADDRESS on a bare hostname and
# restore `tls internal` in the Caddyfile if you'd rather stay fully offline.
GODADDY_API_TOKEN=KEY:SECRET
# --- Deploy / backup (Phase 18) ----------------------------------------------
# `scripts/deploy.sh` (make deploy) backs the database up before migrating and
# keeps this many of the newest backups under data/backups (0 = keep all).
EA_BACKUP_KEEP=14
# Seconds the deploy waits for the app to report healthy before rolling back.
EA_DEPLOY_HEALTH_TIMEOUT=120
# Which git remote `make check-update` checks for newer release tags. A git
# remote NAME (e.g. origin, or `upstream` if you forked and want to track the
# original repo) or a full URL. Defaults to origin.
EA_UPDATE_REMOTE=origin
# --- myFund.pl investment pull (Phase 6) -------------------------------------
# OPT-IN and OFF by default. Leave EA_MYFUND_API_KEY empty and the app makes ZERO
# outbound calls (stays fully offline). Set both to enable the "Fetch now" button
# on the Investments page (a read-only pull of your own portfolio). Generate the
# key in myFund: Menu > Konto > Ustawienia konta > Klucz API.
EA_MYFUND_API_KEY=
EA_MYFUND_PORTFOLIO=
# Background worker auto-fetch. Leave the interval empty/0 and the worker never
# reaches out (the manual button still works). To enable it, set a positive
# interval AND the portfolio Account id to import into.
EA_MYFUND_FETCH_INTERVAL_HOURS=
EA_MYFUND_ACCOUNT_ID=
# --- Home Assistant via MQTT (Phase 7) ---------------------------------------
# OPT-IN and OFF by default. Leave EA_MQTT_HOST empty and the app opens ZERO MQTT
# connections. This is NOT internet egress — the broker is your Home Assistant
# broker on the LAN. Set the host to push auto-discovered sensors (net worth,
# monthly spend, per-account balances) to HA. Sensors appear under an "Expense
# Analyzer" device automatically (MQTT discovery).
EA_MQTT_HOST=
EA_MQTT_PORT=1883
EA_MQTT_USERNAME=
EA_MQTT_PASSWORD=
# Topic prefix for this app's state/availability/alert topics.
EA_MQTT_BASE_TOPIC=expense_analyzer
# Where HA listens for discovery configs (HA's default is "homeassistant").
EA_MQTT_DISCOVERY_PREFIX=homeassistant
# Worker auto-publish cadence (minutes). Empty/0 = the worker never publishes on
# its own; the "Publish now" button on the Home Assistant page still works.
EA_MQTT_PUBLISH_INTERVAL_MINUTES=

# --- Subscription / recurring cost detection (Phase 9) -----------------------
# Derived entirely from your existing transactions — no egress, always on. These
# only tune how forgiving the detector is; the defaults suit a household. See the
# /dashboard/subscriptions page.
# Minimum charges from a merchant before it can be called recurring.
EA_SUBSCRIPTION_MIN_OCCURRENCES=3
# How far a charge may stray from the typical amount (percent) and still count as
# the same subscription (absorbs FX / small plan drift).
EA_SUBSCRIPTION_AMOUNT_TOLERANCE_PCT=15
# How big a jump in the latest charge counts as "the price went up" (HA alert).
EA_SUBSCRIPTION_PRICE_RISE_PCT=10
# A subscription whose first charge is within this many days is flagged "new".
EA_SUBSCRIPTION_NEW_WINDOW_DAYS=35

# --- Categorization classifier (layer 2, Phase 11) ---------------------------
# A local TF-IDF + logistic-regression classifier trained on your confirmed
# categorizations — no egress, always on. Tunables only; defaults suit a
# household. See the /dashboard/queue page.
# Predictions at/above this confidence (0..1) auto-apply the category; below it
# the transaction waits in the review queue for a human.
EA_CLASSIFIER_CONFIDENCE_THRESHOLD=0.7
# Don't train/classify until at least this many confirmed labels exist (and >= 2
# distinct categories) — below that the model is noise.
EA_CLASSIFIER_MIN_TRAINING_SAMPLES=25

# --- Categorization embeddings (layer 3, Phase 12) ---------------------------
# The "weird cases" fallback: embed each transaction and show the most similar
# already-categorized one in the review queue (a suggestion only — never auto-
# applied). No egress: the model is baked into the Docker image at build time and
# read offline at runtime. Fail-safe — if the model can't load, the queue just
# shows no layer-3 hints. Set False to skip the heavy embedding path entirely.
EA_EMBEDDINGS_ENABLED=true
# The (multilingual) sentence-transformers model. Must be bundled in the image;
# changing it means re-bundling at build time.
EA_EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Pin the model to an exact commit (reproducible build; the runtime offline load
# must request the same revision it was bundled with). Change in lockstep with
# EA_EMBEDDINGS_MODEL.
EA_EMBEDDINGS_MODEL_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
# How many nearest labelled neighbours vote on a queued row's category.
EA_EMBEDDINGS_NEIGHBORS=5
# Hide the suggestion when the nearest neighbour's cosine similarity (0..1) is below
# this — too far to be a useful hint.
EA_EMBEDDINGS_MIN_SIMILARITY=0.45
# Don't build the index until at least this many confirmed labels exist (and >= 2
# distinct categories).
EA_EMBEDDINGS_MIN_TRAINING_SAMPLES=25
