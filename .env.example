# Copy to .env and adjust. All settings are prefixed with EA_.
EA_APP_NAME=Expense Analyzer
EA_DEBUG=false
EA_DATABASE_PATH=data/expense_analyzer.db
# Display/bucketing timezone (the app works in UTC internally).
EA_TIMEZONE=Europe/Warsaw
# Max gap (days) between the two legs of an internal transfer for them to pair.
# Default 5 covers PL long-weekend/holiday settlement delays (ELIXIR is biz-days).
EA_TRANSFER_WINDOW_DAYS=5
# Secret for signing session cookies. CHANGE THIS to a long random value, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
EA_SECRET_KEY=change-me-to-a-long-random-value
# Mark the session cookie Secure (HTTPS-only). Keep true in production (behind
# Caddy TLS); set false only for plain-http local dev.
EA_SECURE_COOKIES=true
# How you reach the Pi (hostname or LAN IP) — Caddy issues a self-signed cert
# for this via `tls internal`. Must resolve on your LAN.
CADDY_SITE_ADDRESS=expense.local
