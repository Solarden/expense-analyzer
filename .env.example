# Copy to .env and adjust. All settings are prefixed with EA_.
EA_APP_NAME=Expense Analyzer
EA_DEBUG=false
EA_DATABASE_PATH=data/expense_analyzer.db
# Display/bucketing timezone (the app works in UTC internally).
EA_TIMEZONE=Europe/Warsaw
# Max gap (days) between the two legs of an internal transfer for them to pair.
# Default 5 covers PL long-weekend/holiday settlement delays (ELIXIR is biz-days).
EA_TRANSFER_WINDOW_DAYS=5
# Rows per page on the transaction list.
EA_PAGE_SIZE=50
# Source code URL shown as a "Source" link in the UI (AGPL §13). If you run a
# MODIFIED version, point this at your own published source.
EA_SOURCE_URL=https://github.com/Solarden/expense-analyzer
# Plan-vs-reality loan matching: max gap (days) and amount tolerance (percent of
# the planned installment) for suggesting a transaction as an installment payment.
EA_LOAN_MATCH_WINDOW_DAYS=5
EA_LOAN_MATCH_AMOUNT_TOLERANCE_PCT=5
# Secret for signing session cookies. CHANGE THIS to a long random value, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
EA_SECRET_KEY=change-me-to-a-long-random-value
# Mark the session cookie Secure (HTTPS-only). Keep true in production (behind
# Caddy TLS); set false only for plain-http local dev.
EA_SECURE_COOKIES=true
# How you reach the Pi (hostname or LAN IP) — Caddy issues a self-signed cert
# for this via `tls internal`. Must resolve on your LAN.
CADDY_SITE_ADDRESS=expense.local
# --- myFund.pl investment pull (Phase 6) -------------------------------------
# OPT-IN and OFF by default. Leave EA_MYFUND_API_KEY empty and the app makes ZERO
# outbound calls (stays fully offline). Set both to enable the "Fetch now" button
# on the Investments page (a read-only pull of your own portfolio). Generate the
# key in myFund: Menu > Konto > Ustawienia konta > Klucz API.
EA_MYFUND_API_KEY=
EA_MYFUND_PORTFOLIO=
# Background worker auto-fetch. Leave the interval empty/0 and the worker never
# reaches out (the manual button still works). To enable it, set a positive
# interval AND the portfolio Account id to import into.
EA_MYFUND_FETCH_INTERVAL_HOURS=
EA_MYFUND_ACCOUNT_ID=
# --- Home Assistant via MQTT (Phase 7) ---------------------------------------
# OPT-IN and OFF by default. Leave EA_MQTT_HOST empty and the app opens ZERO MQTT
# connections. This is NOT internet egress — the broker is your Home Assistant
# broker on the LAN. Set the host to push auto-discovered sensors (net worth,
# monthly spend, per-account balances) to HA. Sensors appear under an "Expense
# Analyzer" device automatically (MQTT discovery).
EA_MQTT_HOST=
EA_MQTT_PORT=1883
EA_MQTT_USERNAME=
EA_MQTT_PASSWORD=
# Topic prefix for this app's state/availability/alert topics.
EA_MQTT_BASE_TOPIC=expense_analyzer
# Where HA listens for discovery configs (HA's default is "homeassistant").
EA_MQTT_DISCOVERY_PREFIX=homeassistant
# Worker auto-publish cadence (minutes). Empty/0 = the worker never publishes on
# its own; the "Publish now" button on the Home Assistant page still works.
EA_MQTT_PUBLISH_INTERVAL_MINUTES=

# --- Subscription / recurring cost detection (Phase 9) -----------------------
# Derived entirely from your existing transactions — no egress, always on. These
# only tune how forgiving the detector is; the defaults suit a household. See the
# /dashboard/subscriptions page.
# Minimum charges from a merchant before it can be called recurring.
EA_SUBSCRIPTION_MIN_OCCURRENCES=3
# How far a charge may stray from the typical amount (percent) and still count as
# the same subscription (absorbs FX / small plan drift).
EA_SUBSCRIPTION_AMOUNT_TOLERANCE_PCT=15
# How big a jump in the latest charge counts as "the price went up" (HA alert).
EA_SUBSCRIPTION_PRICE_RISE_PCT=10
# A subscription whose first charge is within this many days is flagged "new".
EA_SUBSCRIPTION_NEW_WINDOW_DAYS=35

# --- Categorization classifier (layer 2, Phase 11) ---------------------------
# A local TF-IDF + logistic-regression classifier trained on your confirmed
# categorizations — no egress, always on. Tunables only; defaults suit a
# household. See the /dashboard/queue page.
# Predictions at/above this confidence (0..1) auto-apply the category; below it
# the transaction waits in the review queue for a human.
EA_CLASSIFIER_CONFIDENCE_THRESHOLD=0.7
# Don't train/classify until at least this many confirmed labels exist (and >= 2
# distinct categories) — below that the model is noise.
EA_CLASSIFIER_MIN_TRAINING_SAMPLES=25
